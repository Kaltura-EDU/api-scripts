# SESSION VARIABLES -----------------------------------------------------------

# Your Kaltura Partner ID (found in KMC under Settings > Integration Settings)
PARTNER_ID=

# Admin secret is entered at runtime via a secure prompt — do not store it here

# User ID for the Kaltura session (typically your email address)
USER_ID=

# SCRIPT VARIABLES ------------------------------------------------------------

# The base URL of your MediaSpace instance (e.g., https://mediaspace.example.edu)
MEDIA_SPACE_URL=

# The category ID of the new channel's parent category
PARENT_ID=

# Privacy context for the channel (usually "MediaSpace")
PRIVACY_CONTEXT=MediaSpace

# Channel name (required)
CHANNEL_NAME=

# Channel owner's Kaltura user ID
OWNER=

# Optional channel description
CHANNEL_DESCRIPTION=

# Optional: comma-separated lists of Kaltura user IDs, by permission level.
# A user listed in more than one is assigned the highest level (Manager >
# Moderator > Contributor > Member). The owner is already a manager.
MANAGERS=
MODERATORS=
CONTRIBUTORS=
MEMBERS=

# 1=Anyone, 2=Any logged-in user, 3=Channel members only
CHANNEL_PRIVACY=3

# 1=Join automatically, 2=Request to join, 3=Not allowed
USER_JOIN_POLICY=3

# 1=Partner only (everyone), 3=Category members only
APPEAR_IN_LIST=3

# 1=Inherit, 2=Manual
INHERITANCE_TYPE=2

# 0=Manager, 1=Moderator, 2=Contributor, 3=Member
DEFAULT_PERMISSION_LEVEL=3

# 1=All Members, 2=Members with Permission
CONTRIBUTION_POLICY=2

# 0=No Moderation, 1=Moderation
MODERATION=0
