# This script asks for everything it needs when you run it (Partner ID, the
# admin secret, and so on), so a .env file is optional. The settings below
# are only needed if Kaltura is slow or your connection is unreliable.
# The admin secret is prompted at runtime — never put it here.

# ── Reliability ───────────────────────────────────────────────────────────────
# Seconds before an individual API request times out
REQUEST_TIMEOUT=120
# Retries for transient network errors (timeouts, resets) before giving up
MAX_NETWORK_RETRIES=5
# Base seconds between retries (grows linearly: delay × attempt)
NETWORK_RETRY_DELAY=5
