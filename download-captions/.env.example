# SESSION VARIABLES -----------------------------------------------------------

# Your Kaltura partner ID (found in KMC under Settings > Integration Settings)
PARTNER_ID=

# The Kaltura service URL
KALTURA_SERVICE_URL=https://www.kaltura.com/

# Optional Kaltura user ID for audit logs (e.g., api-username)
KALTURA_USER=

# NOTE: the admin secret is NOT stored here. The script prompts for it
# interactively at runtime so it is never written to disk.

# RELIABILITY -----------------------------------------------------------------
# Transient network errors (timeouts, connection resets) are retried
# automatically. These are optional; the defaults shown are used if unset.

# Seconds before an individual API request times out
REQUEST_TIMEOUT=120
# Number of retries on transient network errors
MAX_NETWORK_RETRIES=5
# Base seconds between retries (grows linearly: delay × attempt)
NETWORK_RETRY_DELAY=5

# SCRIPT VARIABLES ------------------------------------------------------------
# NOTE: each run writes into a timestamped subfolder of "output/" next to the
# script (e.g. output/2026-07-28_142530/), so batches stay separated.

# Controls what gets saved for CAPTIONS: srt (default — original file only),
# txt (converted transcript, no timecodes), or both. Does NOT affect audio
# descriptions, which are always kept in their original format (converting
# them to TXT would strip the timecodes that make them useful).
OUTPUT_FORMAT=srt

# CAPTION-ASSET TYPES ---------------------------------------------------------
# In Kaltura, both captions and audio descriptions are "caption assets". Choose
# which types to download. AT LEAST ONE must be true, or the script exits with
# an error. Each asset is sorted into exactly one bucket:
#   - Audio descriptions: identified by the asset's usage field (usage=1). This
#     is reliable; the label is not.
#   - ASR (machine) captions: a caption whose label contains AUTO_GENERATED_LABEL.
#   - Non-ASR captions: every other caption. "Non-ASR" only means "not labeled
#     as machine-generated" — it does NOT guarantee the captions are accurate.
INCLUDE_ASR_CAPTIONS=true
INCLUDE_NON_ASR_CAPTIONS=true
INCLUDE_AUDIO_DESCRIPTIONS=false

# The suffix KMC appends to auto-generated caption labels — configured in KMC
# under Settings > Reach > Service Parameters ("machine captions label
# suffix"). Enter ONLY that suffix (e.g. "(auto-generated)"), NOT a full label
# like "English (auto-generated)". It is matched as a case-insensitive
# substring, so it catches the suffix in every language. Needed only when
# INCLUDE_ASR_CAPTIONS and INCLUDE_NON_ASR_CAPTIONS differ (i.e. the script
# has to tell the two apart).
AUTO_GENERATED_LABEL=(auto-generated)

# Set to true to include entries from subcategories when filtering by category ID
INCLUDE_CHILD_CATEGORIES=true

# FILENAME PARTS --------------------------------------------------------------
# The entry ID is ALWAYS included in each filename. The three toggles below add
# optional components. AT LEAST ONE must be true, or the script exits with an
# error (otherwise filenames would be just the bare entry ID).

# Include the entry's (video's) creation date, e.g. 2023-08-01. This is the
# ENTRY creation date (entry.createdAt), NOT the caption track's own date, and
# is the same for every caption track on a given entry.
INCLUDE_CREATION_DATE_IN_FILENAMES=false
# Include the entry (video) title, e.g. XSE1_5B_Axial_Compression
INCLUDE_CAPTION_NAME_IN_FILENAMES=true
# Include the caption track label, e.g. English or English (auto-generated)
INCLUDE_CAPTION_LABEL_IN_FILENAMES=true

# Set to true to skip child entries in multi-stream entries
SKIP_CHILD_ENTRIES=true

# Set to true to enable debug output for troubleshooting
DEBUG=false

# QUERY FILTERS ---------------------------------------------------------------
# Set one. If multiple are set, priority order is: ENTRY_IDS > CATEGORY_IDS > TAGS > OWNER.

CATEGORY_IDS=
TAGS=
ENTRY_IDS=
OWNER=
