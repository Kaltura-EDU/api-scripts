# =============================================================================
# upload-entries.py configuration
#
# QUICK START
#   1. Copy this file to a new file named exactly ".env" (with the leading dot):
#          cp .env.example .env
#      On macOS the dot makes it "hidden" in Finder — press Cmd+Shift+. to see
#      hidden files, or just edit it from the Terminal.
#   2. Fill in PARTNER_ID below. (The Admin Secret is NOT stored here — the
#      script asks for it each time you run, so it never touches disk.)
#   3. Set any of the optional metadata (tags, owner, collaborators, categories)
#      you want applied to everything you upload.
#   4. Drop your media files into the "input" folder and run the script.
#
# Anything left blank is simply skipped — only PARTNER_ID is required.
# =============================================================================


# -----------------------------------------------------------------------------
# Kaltura API credentials (REQUIRED: PARTNER_ID)
# -----------------------------------------------------------------------------
# Your numeric Kaltura account ID (KMC → Settings → Integration Settings).
PARTNER_ID=

# Session user ID. Leave blank to use the account default. This is only the
# identity the API session runs AS — to set who OWNS the uploaded entries, use
# OWNER_ID further down.
USER_ID=

# Almost always leave these two at their defaults.
SERVICE_URL=https://www.kaltura.com/
PRIVILEGES=all:*,disableentitlement


# -----------------------------------------------------------------------------
# Metadata applied to EVERY uploaded file (all optional)
# -----------------------------------------------------------------------------
# Kaltura user ID that should OWN the new entries. Blank = the session user.
OWNER_ID=

# Comma-separated tags added to every entry, e.g.  fall2026,orientation,dept-bio
TAGS=

# Description text applied to every entry (optional).
DESCRIPTION=

# Collaborators allowed to EDIT the entries (KMC "co-editors"). Comma-separated
# Kaltura user IDs, e.g.  jsmith,adoe@ucsd.edu
COEDITORS=

# Collaborators allowed to PUBLISH the entries (KMC "co-publishers").
COPUBLISHERS=

# Category memberships. You can use EITHER numeric IDs, full category paths, or
# both — every entry is added to all of them.
#   CATEGORY_IDS   — numeric IDs from KMC → Content → Categories, e.g.  12345,67890
#   CATEGORY_NAMES — full paths, e.g.  MediaSpace>site>channels>biology
#                    (ambiguous names will prompt you to pick the right one)
CATEGORY_IDS=
CATEGORY_NAMES=

# Optional transcoding/conversion profile ID for the new entries. Blank uses
# your account's default profile (correct for almost everyone).
CONVERSION_PROFILE_ID=


# -----------------------------------------------------------------------------
# Local folders & file handling
# -----------------------------------------------------------------------------
# Folder the script reads files from, and where the CSV report is written.
INPUT_DIR=input
OUTPUT_DIR=output

# After a file uploads successfully it is moved out of the input folder so a
# re-run won't upload it twice. Uploaded files go to PROCESSED_DIR; files that
# failed go to FAILED_DIR (so you can retry just those). Set MOVE_ON_SUCCESS to
# false to leave every file exactly where it is.
MOVE_ON_SUCCESS=true
PROCESSED_DIR=input/_uploaded
FAILED_DIR=input/_failed

# Preview mode: when true, the script lists what it WOULD upload and stops
# without creating anything in Kaltura. Great for a first run.
DRY_RUN=false


# -----------------------------------------------------------------------------
# Upload reliability (defaults are good — only touch these if uploads misbehave)
# -----------------------------------------------------------------------------
# Files are uploaded in chunks this many megabytes each. This is the setting
# that makes large videos upload reliably. If uploads stall on a slow or flaky
# connection, LOWER this (e.g. 2). On a fast, stable connection you can raise it.
UPLOAD_CHUNK_MB=5

# Per-request timeout in seconds. Generous on purpose; chunking means no single
# request should ever get close to this.
REQUEST_TIMEOUT=600

# Transient-network-error retries and the base delay between them (grows
# linearly: delay × attempt number).
MAX_NETWORK_RETRIES=5
NETWORK_RETRY_DELAY=5

# How many files to upload at once. Uploading is limited by your OUTBOUND
# bandwidth, so more workers only help if your uplink isn't already maxed out.
# On a slow or flaky connection, set this to 1 or 2 for the most reliable runs;
# on a fast, stable connection you can raise it. (Each worker opens its own
# Kaltura session, which is expected and fine.)
MAX_WORKERS=4
