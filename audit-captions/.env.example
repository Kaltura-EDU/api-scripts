# audit-captions.py configuration
# ---------------------------------------------------------------------------
# Copy this file to ".env" in the same folder and edit the values below.
# (On macOS, press Cmd+Shift+.  in Finder to show hidden dotfiles like .env.)
#
# Every setting below is optional — anything left blank is prompted for at
# runtime instead. IMPORTANT: the Admin Secret is NEVER stored here; the
# script always prompts for it.
# ---------------------------------------------------------------------------

# Your Kaltura Partner ID — the numeric account ID. Not secret (it shows up
# in the KMC and in every API URL). If blank, the script asks for it.
PARTNER_ID=

# Also check for a ready Extended Audio Description (EAD) asset on each
# entry, in addition to the regular caption check. true / false.
CHECK_EAD=false

# How many times to retry a failing API call before giving up on it.
RETRY_ATTEMPTS=3

# Number of entries to audit concurrently. Minimum 1. Actual API call speed
# is capped separately by AUDIT_RATE_PER_SEC below, regardless of this value.
MAX_WORKERS=3

# Maximum API calls per second, shared across all workers combined. This is
# a reasonable starting point, not a number measured against a real
# account's throttle limit — lower it if you see errors that look like rate
# limiting. 0 disables pacing entirely.
AUDIT_RATE_PER_SEC=5

# --- Only used if you choose the CSV input method at the prompt -----------

# Path to the input CSV, relative to this script's folder.
INPUT_FILENAME=input/entries.csv

# Header name of the column in that CSV containing entry IDs.
COLUMN_HEADER_ENTRY_ID=Entry ID

# ── Reliability ───────────────────────────────────────────────────────────────
# Seconds before an individual API request times out
REQUEST_TIMEOUT=120
# Retries for transient network errors (timeouts, resets) before giving up
MAX_NETWORK_RETRIES=5
# Base seconds between retries (grows linearly: delay × attempt)
NETWORK_RETRY_DELAY=5
