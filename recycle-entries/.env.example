

# -----------------------------------------------------------------------------
# Kaltura API Credentials
# -----------------------------------------------------------------------------
PARTNER_ID=
# ADMIN_SECRET is prompted at runtime — never put it here.
USER_ID=
SERVICE_URL=https://www.kaltura.com/
PRIVILEGES=all:*,disableentitlement

# -----------------------------------------------------------------------------
# Timezone for output filename timestamps
# Example: America/Los_Angeles, America/New_York, Europe/London
# -----------------------------------------------------------------------------
TIMEZONE=America/Los_Angeles

# -----------------------------------------------------------------------------
# CSV input configuration
# INPUT_FILENAME should point to the CSV containing entry IDs.
# COLUMN_HEADER_ENTRY_ID is the header name of the column containing entry IDs.
# Additional columns in the CSV are preserved in the output.
# -----------------------------------------------------------------------------
INPUT_FILENAME=input/entries.csv
COLUMN_HEADER_ENTRY_ID=Entry ID

# -----------------------------------------------------------------------------
# Execution controls
# -----------------------------------------------------------------------------

# When true, no recycle operations are performed. The script only reports
# what WOULD happen.
DRY_RUN=true

# When true, the script calls baseEntry.get() before attempting recycle
# so it can detect missing entries or already‑recycled entries.
VALIDATE_ENTRY_EXISTS=false
# When DRY_RUN is true, control whether the script also performs a live
# baseEntry.get() check for each entry. Setting this to false makes dry runs
# much faster, but the script will not distinguish missing entries during dry run.
VALIDATE_ENTRY_EXISTS_IN_DRY_RUN=false

# Number of concurrent workers. This is NOT the speed dial —
# RECYCLE_RATE_PER_SEC below caps that. A few workers keep the run moving
# while one waits on a slow call or sits out a throttle retry. Beyond about
# 3, extra workers just wait their turn.
MAX_WORKERS=3

# Kaltura throttles recycles and rejects anything above the limit with
# ACTION_BLOCKED (which looks like a permission error, but isn't). Measured
# on UCSD's account: at ~22 calls/sec only ~9% of recycles landed, holding
# steady at ~2 successful recycles/sec. Pacing below that ceiling gets
# nearly all of them through instead. Set to 0 to disable pacing.
RECYCLE_RATE_PER_SEC=1.5

# ACTION_BLOCKED is usually a throttle response, not a permanent state, so
# the script retries it: how many extra attempts, and the base seconds
# between them (the wait grows: 10, 20, 30, 40).
BLOCKED_RETRIES=4
BLOCKED_RETRY_DELAY=10

# Retry configuration for network errors (timeouts, dropped connections)
MAX_RETRIES=3
BACKOFF_BASE_SEC=1

# Extra pause after each request, per worker (seconds). No longer needed
# for throttling — RECYCLE_RATE_PER_SEC handles that — so leave at 0.
REQUEST_DELAY_SEC=0
PROGRESS_EVERY=1
REQUEST_TIMEOUT_SEC=10
REQUEST_CONNECT_TIMEOUT_SEC=10