# SESSION VARIABLES -----------------------------------------------------------

# Required. Your Kaltura Partner ID, a number (KMC → Settings → Integration
# Settings)
KALTURA_PARTNER_ID=

# ADMIN_SECRET is prompted at runtime — never put it here.

# Optional. The user ID the session runs as, usually your own (e.g., your
# email address). Shows up in Kaltura's logs as the person who made the change.
KALTURA_USER=

# Kaltura's API address. Leave as is unless Kaltura told you otherwise.
KALTURA_SERVICE_URL=https://www.kaltura.com

# RELIABILITY -----------------------------------------------------------------

# Seconds before an individual API request times out
REQUEST_TIMEOUT=120
# Retries for network hiccups (timeouts, dropped connections) before giving up
MAX_NETWORK_RETRIES=5
# Base seconds between retries (grows each time: delay × attempt)
NETWORK_RETRY_DELAY=5

# INPUT FILE ------------------------------------------------------------------

# Required. The filename of your channel list, placed in the input/ folder
# next to the script (e.g., channelDetails.csv)
INPUT_FILENAME=

# CHANNELS --------------------------------------------------------------------

# Required. The base URL of your MediaSpace site
# (e.g., https://mediaspace.example.edu). Ending it in /channel/ also works.
KALTURA_MEDIASPACE_URL=

# Required. The category ID new channels are created under, usually your
# MediaSpace site's "channels" category (KMC → Content → Categories).
KALTURA_PARENT_ID=

# The full category path of that parent, used to check for channel names that
# already exist. It must match the hierarchy shown in KMC.
KALTURA_FULL_NAME_PREFIX=MediaSpace>site>channels>

# Privacy context for channels (usually "MediaSpace")
KALTURA_PRIVACY_CONTEXT=MediaSpace

# CHANNEL PRIVACY -------------------------------------------------------------
# Who can see a channel's content:
# 1=Anyone, 2=Any logged-in user, 3=Channel members only
#
# Set it for every channel here, or give channels their own values with a
# privacy column in your CSV (named below in KALTURA_PRIVACY_SETTING_HEADER).
# When the CSV has that column, its values win, and blank cells use this one.
# Leave this blank to require a value in every row of the column.
KALTURA_CHANNEL_PRIVACY=3

# CHANNEL SETTINGS (applied to every channel) ---------------------------------

# Can people add themselves to the channel?
# 1=Join automatically, 2=Request to join, 3=Not allowed
KALTURA_USER_JOIN_POLICY=3

# Who can find the channel in lists and search:
# 1=Everyone on your Kaltura site, 3=Channel members only
KALTURA_APPEAR_IN_LIST=3

# Where the channel's user list comes from:
# 1=Copy it from the parent category, 2=Set it for this channel (needed for the
# manager, moderator, contributor, and member columns to work)
KALTURA_INHERITANCE_TYPE=2

# The role new users get when they join without a role being chosen:
# 0=Manager, 1=Moderator, 2=Contributor, 3=Member
KALTURA_DEFAULT_PERMISSION_LEVEL=3

# Who can add media: 1=All members, 2=Only users with contributor access or
# higher
KALTURA_CONTRIBUTION_POLICY=2

# Must media be approved before it appears? 0=No, 1=Yes
KALTURA_MODERATION=0

# CSV COLUMN HEADERS ----------------------------------------------------------
# Change these only if your CSV uses different column names.

KALTURA_CHANNEL_NAME_HEADER=channelName
KALTURA_OWNER_ID_HEADER=owner

# Optional user columns. Each cell holds comma-separated Kaltura user IDs.
# Leave a column out of your CSV if you don't need it. If someone is listed
# under more than one role, they get the highest one. Don't list the owner:
# they already have full control of the channel.
# Managers: full control, including channel settings and who belongs
KALTURA_CHANNEL_MANAGERS_HEADER=managers
# Moderators: can add media and approve or reject media others submit
KALTURA_CHANNEL_MODERATORS_HEADER=moderators
# Contributors: can add media to the channel
KALTURA_CHANNEL_CONTRIBUTORS_HEADER=contributors
# Members: can view the channel
KALTURA_CHANNEL_MEMBERS_HEADER=members

# Optional column. If your CSV has no column by this name, every channel gets
# KALTURA_CHANNEL_PRIVACY. Leave blank to ignore any privacy column.
KALTURA_PRIVACY_SETTING_HEADER=privacy
