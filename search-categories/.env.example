# ── Kaltura Credentials ───────────────────────────────────────────────────────
# Your Kaltura Partner ID, as a number. Leave blank and the script asks for it.
PARTNER_ID=
# ADMIN_SECRET is prompted at runtime — do not store it here
# Kaltura user the session runs as (optional)
USER_ID=
SERVICE_URL=https://www.kaltura.com
# disableentitlement makes MediaSpace channels and galleries visible. Without
# it, an admin session only sees a fraction of your categories.
PRIVILEGES=all:*,disableentitlement

# ── Reliability ───────────────────────────────────────────────────────────────
# Seconds before an individual API request times out
REQUEST_TIMEOUT=120
# Retries for transient network errors (timeouts, resets) before giving up
MAX_NETWORK_RETRIES=5
# Base seconds between retries (grows linearly: delay × attempt)
NETWORK_RETRY_DELAY=5

# ── Output ────────────────────────────────────────────────────────────────────
# Save every match to a CSV in the output folder (True/False)
EXPORT_CSV=True
# Subfolder, next to the script, that the CSV is written into
OUTPUT_DIR=output
# How many matches to list on screen (0 = all). The CSV always has every match.
PRINT_LIMIT=50
# Timezone for the dates shown in results and for date filters
# (e.g., US/Pacific, US/Eastern, Europe/Rome)
TIMEZONE=US/Pacific
# Sort order: FULL_NAME_ASC, NAME_ASC, CREATED_AT_DESC, UPDATED_AT_DESC,
# ENTRIES_COUNT_DESC, DIRECT_ENTRIES_COUNT_DESC, MEMBERS_COUNT_DESC,
# DEPTH_ASC (and the _ASC / _DESC twin of each). Blank = FULL_NAME_ASC.
ORDER_BY=FULL_NAME_ASC
# Stop after this many matches (blank = all)
MAX_RESULTS=
# Only used if a search matches more than Kaltura's 10,000-result cap, in which
# case it is split into creation-date ranges starting here (YYYY-MM-DD).
EARLIEST_START_DATE=

# ── Search Filters ────────────────────────────────────────────────────────────
# Leave a filter blank to ignore it. Comma-separated values within one filter
# are treated as OR. Different filters that are filled in are combined as AND.
# With nothing filled in, the script offers to list every category.

# ── Which categories ──────────────────────────────────────────────────────────
# Numeric category IDs (KMC: Content > Categories)
CATEGORY_ID=
# Leave these category IDs out of the results
EXCLUDE_CATEGORY_ID=
# Direct children of these category IDs
PARENT_ID=
# Everything underneath these category IDs, at any depth
ANCESTOR_ID=
# Level in the tree: 0 = top level, 1 = its children, and so on
DEPTH=
# Word search across category name, description and tags
SEARCH_TEXT=
# External/reference ID assigned outside of Kaltura (e.g., from a CMS)
REFERENCE_ID=
# True = only categories with NO reference ID; False = only those WITH one
HAS_NO_REFERENCE_ID=

# ── Category path ─────────────────────────────────────────────────────────────
# The full path uses ">" between levels, e.g. MediaSpace>site>channels>My Channel
FULL_NAME_EQUALS=
# Paths that start with this, e.g. MediaSpace>site>channels lists every channel
FULL_NAME_BEGINS_WITH=

# ── Category name ─────────────────────────────────────────────────────────────
# These look at the category's own name (the last part of its path). Kaltura
# cannot filter on them, so they are applied after the results come back and
# are not case-sensitive.
CATEGORY_NAME_EQUALS=
CATEGORY_NAME_BEGINS_WITH=
CATEGORY_NAME_CONTAINS=
CATEGORY_NAME_ENDS_WITH=
# Leave out categories whose name contains any of these
CATEGORY_NAME_NOT_CONTAINS=
# Same idea, but matched anywhere in the full path
FULL_NAME_CONTAINS=
FULL_NAME_NOT_CONTAINS=

# ── People ────────────────────────────────────────────────────────────────────
# Owner's user ID. The owner field is checked after the results come back, but
# first Kaltura narrows the search to categories this user manages (owners are
# normally managers too), which is much faster than scanning every category.
OWNER_ID=
# Set False to scan every category and check only the owner field. Slower, but
# finds owners who are not managers. Ignored if MANAGER_ID is filled in.
OWNER_PREFILTER=True
# Users who are managers of the category
MANAGER_ID=
# Users who are members of the category (any role)
MEMBER_ID=

# ── Tags ──────────────────────────────────────────────────────────────────────
# Categories with ANY of these tags
TAG_ANY=
# Categories with ALL of these tags
TAG_ALL=
# Admin tags (only you and other admins see these). Applied after the results
# come back; matches whole tags.
ADMIN_TAG=

# ── Settings ──────────────────────────────────────────────────────────────────
# Who can see the category's content: ALL, AUTHENTICATED_USERS, MEMBERS_ONLY
PRIVACY=
# Who can see the category in lists: PARTNER_ONLY, CATEGORY_MEMBERS_ONLY
APPEAR_IN_LIST=
# Where members come from: INHERIT (from the parent category) or MANUAL
INHERITANCE_TYPE=
# Who may add media: ALL or MEMBERS_WITH_CONTRIBUTION_PERMISSION
CONTRIBUTION_POLICY=
# Context the category belongs to. MediaSpace channels use "MediaSpace".
# Not yet confirmed against a live search; if it finds nothing, use
# FULL_NAME_BEGINS_WITH=MediaSpace>site>channels instead.
PRIVACY_CONTEXT=
# True = only moderated categories; False = only unmoderated ones
# (applied after the results come back)
MODERATED=
# UPDATING, ACTIVE, DELETED, PURGED. Blank = Kaltura's default.
STATUS=

# ── Size ──────────────────────────────────────────────────────────────────────
# Number of members (include both ends; leave either blank)
MEMBERS_MIN=
MEMBERS_MAX=
# Members waiting for approval
PENDING_MEMBERS_MIN=
PENDING_MEMBERS_MAX=
# The next three are applied after the results come back.
# ENTRIES counts media in the category AND its subcategories;
# DIRECT_ENTRIES counts media in the category itself.
# ENTRIES_MAX=0 finds empty categories.
ENTRIES_MIN=
ENTRIES_MAX=
DIRECT_ENTRIES_MIN=
DIRECT_ENTRIES_MAX=
# Number of subcategories directly underneath
SUBCATEGORIES_MIN=
SUBCATEGORIES_MAX=

# ── Dates (YYYY-MM-DD; whole days, both ends included) ───────────────────────
CREATED_AFTER=
CREATED_BEFORE=
UPDATED_AFTER=
UPDATED_BEFORE=
