# Required Kaltura session variables
PARTNER_ID=
# ADMIN_SECRET is prompted at runtime — never put it here.
USER_ID=api-user
PRIVILEGES=all:*,disableentitlement

# === CATEGORY LOOKUP OPTIONS ===
# Option 1: Use full category ID (recommended for precision)
CATEGORY_ID=

# Option 2: Use a channel name (typically the Canvas course ID for Canvas Media Galleries)
# This name must correspond to the final node in the full category hierarchy.
# Only works if CATEGORY_PATH_PREFIX below matches your Canvas Media Gallery or MediaSpace hierarchy
# Example full name path: Canvas_Prod>site>channels>15712
CATEGORY_PATH_PREFIX=Canvas_Prod>site>channels>
CHANNEL_NAME=

# === ENTRY INPUTS ===
# Comma-separated list of entry IDs (required)
ENTRY_IDS=

# ── Reliability ───────────────────────────────────────────────────────────────
# Seconds before an individual API request times out
REQUEST_TIMEOUT=120
# Retries for transient network errors (timeouts, resets) before giving up
MAX_NETWORK_RETRIES=5
# Base seconds between retries (grows linearly: delay × attempt)
NETWORK_RETRY_DELAY=5
