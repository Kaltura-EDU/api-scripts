# ── Kaltura Credentials ───────────────────────────────────────────────────────
# KALTURA PID as a number, not a string
PARTNER_ID=
# ADMIN_SECRET is prompted at runtime — do not store it here
USER_ID=
SERVICE_URL=https://www.kaltura.com
PRIVILEGES=all:*,disableentitlement

# ── Reliability ───────────────────────────────────────────────────────────────
# Seconds before an individual API request times out
REQUEST_TIMEOUT=120
# Retries for transient network errors (timeouts, resets) before giving up
MAX_NETWORK_RETRIES=5
# Base seconds between retries (grows linearly: delay × attempt)
NETWORK_RETRY_DELAY=5
# Pages fetched at the same time, each on its own Kaltura session (1 = one at a
# time). Higher isn't always faster: if you see timeouts or errors under load,
# lower this rather than raising MAX_NETWORK_RETRIES.
MAX_WORKERS=10

# ── Output ────────────────────────────────────────────────────────────────────
EXPORT_CSV=True
# Subfolder the CSV is written into (created automatically if missing)
OUTPUT_DIR=output
# Set your desired timezone (e.g., US/Pacific, US/Eastern, Europe/Rome)
TIMEZONE=US/Pacific
# The earliest date your Kaltura repository contains entries (YYYY-MM-DD).
# Used as a fallback start date when CREATED_AFTER is not set, to scope time-based auto-chunking.
EARLIEST_START_DATE=

# ── Search Filters ────────────────────────────────────────────────────────────
# Comma-separated values within a variable are treated as OR.
# Multiple variables with values filled in are combined as AND.

# Pre-narrow name filters at the API for speed (True), or match names purely
# client-side (False) — slower but exhaustive if the API pre-filter misses.
NAME_PREFILTER=True

# Also list each match's child entries (e.g., the extra layouts of a Zoom
# recording, or the second stream of a dual-screen recording) right under their
# parent. Kaltura hides children from normal searches, so this costs one extra
# request per matched entry. Set False to skip.
INCLUDE_CHILDREN=True

# One or more Kaltura entry IDs (e.g., 0_abc123,0_def456)
ENTRY_ID=
# External/reference ID assigned to the entry outside of Kaltura (e.g., from a CMS or DAM)
REFERENCE_ID=
# Full-text search across name, description, and tags
SEARCH_TEXT=

# ── Name Filters ──────────────────────────────────────────────────────────────
# Note: ENTRY_NAME_ENDS_WITH and ENTRY_NAME_NOT_CONTAINS are applied locally
# after the API query and do not reduce the number of API calls made.
ENTRY_NAME_EQUALS=
# Match entries whose name starts with any of these terms (comma = OR)
ENTRY_NAME_BEGINS_WITH=
ENTRY_NAME_CONTAINS=
ENTRY_NAME_ENDS_WITH=
# Exclude entries whose name contains any of these terms
ENTRY_NAME_NOT_CONTAINS=

# ── Owner ─────────────────────────────────────────────────────────────────────
# Kaltura user ID of the entry owner (the person who originally uploaded it)
OWNER_ID=
# Match owners whose user ID starts / ends with any of these terms (comma = OR,
# not case-sensitive). e.g. OWNER_STARTS_WITH=jdoe  or  OWNER_ENDS_WITH=@ucsd.edu
# Note: applied locally after the API query, so on their own they scan every
# entry in the date range. Pair with CREATED_AFTER/CREATED_BEFORE when you can.
OWNER_STARTS_WITH=
OWNER_ENDS_WITH=

# ── Tags ──────────────────────────────────────────────────────────────────────
TAG=

# ── Categories ────────────────────────────────────────────────────────────────
# Numeric Kaltura category IDs (find in KMC under Content > Categories)
CATEGORY_ID=
# Full category path as it appears in Kaltura (e.g., MediaSpace>site>channels>mychannel)
CATEGORY_NAME=

# ── Media Type ────────────────────────────────────────────────────────────────
# Options: VIDEO, AUDIO, IMAGE, LIVE_STREAM_FLASH, LIVE_STREAM_WINDOWS_MEDIA,
#          LIVE_STREAM_REAL_MEDIA, LIVE_STREAM_QUICKTIME
MEDIA_TYPE=

# ── Entry Status ──────────────────────────────────────────────────────────────
# If left blank, Kaltura defaults to returning only READY entries.
# Options: READY, PENDING, DELETED, BLOCKED, MODERATE, NO_CONTENT,
#          ERROR_CONVERTING, ERROR_IMPORTING, IMPORT, PRECONVERT
STATUS=

# ── Moderation Status ─────────────────────────────────────────────────────────
# Options: PENDING_MODERATION, APPROVED, REJECTED, FLAGGED_FOR_REVIEW,
#          AUTO_APPROVED, DELETED
MODERATION_STATUS=

# ── Date Ranges (YYYY-MM-DD) ──────────────────────────────────────────────────
# Filter by when entries were originally uploaded/created in Kaltura.
# CREATED_ON matches a single day; mutually exclusive with AFTER/BEFORE.
CREATED_ON=
CREATED_AFTER=
CREATED_BEFORE=
# Filter by when entries were last modified
UPDATED_AFTER=
UPDATED_BEFORE=

# ── Duration ──────────────────────────────────────────────────────────────────
# Filter by duration bounds in seconds (e.g., 60 = 1 minute, 3600 = 1 hour)
DURATION_MIN_SEC=
DURATION_MAX_SEC=
