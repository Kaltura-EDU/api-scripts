# SESSION VARIABLES -----------------------------------------------------------

# Your Kaltura partner ID (found in KMC under Settings > Integration Settings).
# Leave blank and the script asks for it when it runs.
KALTURA_PARTNER_ID=

# The Kaltura service URL
KALTURA_SERVICE_URL=https://www.kaltura.com

# Optional Kaltura user ID for audit logs (e.g., api-username). Defaults to
# "admin".
KALTURA_USER=

# NOTE: the admin secret is NOT stored here. The script prompts for it at
# runtime so it is never written to disk.

# FLAVORS TO KEEP -------------------------------------------------------------
# The source flavor is always kept. List any other flavor params IDs to keep
# too, comma-separated (e.g. 487061,487071). Find them in KMC > Settings >
# Transcoding > click the profile > Flavors:
# https://kmc.kaltura.com/index.php/kmcng/settings/transcoding/list
ADDITIONAL_FLAVORS_TO_KEEP=

# WHICH ENTRIES TO PROCESS ----------------------------------------------------
# Leave all blank and the script asks you. Otherwise, use ONE of:
#   - INPUT_FILENAME: a CSV of entry IDs in the "input" folder next to this
#     script (best for long lists). Wins over everything else below.
#   - ENTRY_IDS: comma-separated entry IDs.
#   - TAGS and/or CATEGORY_IDS: comma-separated. When both are set, an entry
#     must match both.

INPUT_FILENAME=
# The header of the entry ID column in your CSV (not case-sensitive). A CSV
# with only one column works whatever its header says.
COLUMN_HEADER_ENTRY_ID=Entry ID

ENTRY_IDS=
TAGS=
CATEGORY_IDS=

# SPEED AND SAFETY ------------------------------------------------------------

# How many entries to work on at once, for both looking up and deleting.
MAX_WORKERS=10
# Print a progress line every this many entries.
PROGRESS_EVERY=100

# true (default) = skip looking up each entry's name and owner, which is
# faster for large runs. The reports then leave those columns blank.
SKIP_ENTRY_METADATA=true

# true = skip the "Type DELETE" confirmation and delete right after the
# preview. Only use this once you trust the preview output.
SKIP_CONFIRMATION=false

# RELIABILITY -----------------------------------------------------------------
# Transient network errors (timeouts, connection resets) are retried
# automatically. These are optional; the defaults shown are used if unset.

# Seconds before an individual API request times out
REQUEST_TIMEOUT=120
# Number of retries on transient network errors
MAX_NETWORK_RETRIES=5
# Base seconds between retries (grows linearly: delay × attempt)
NETWORK_RETRY_DELAY=5
