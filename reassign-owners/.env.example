# -----------------------------------------------------------------------------
# Kaltura API Credentials
# -----------------------------------------------------------------------------
# Your Kaltura Partner ID (a number), from KMC → Settings → Integration Settings
PARTNER_ID=
# ADMIN_SECRET is prompted at runtime — never put it here.
# The user ID the session runs as (shows up in Kaltura's change history)
USER_ID=
SERVICE_URL=https://www.kaltura.com/
PRIVILEGES=all:*,disableentitlement

# -----------------------------------------------------------------------------
# Mode
# -----------------------------------------------------------------------------
# MODE determines how entries are picked. Leave blank to be asked each run.
# - owner_map: CSV of old user -> new user (reassigns ALL entries owned by each old user)
# - entry_map: CSV of entry_id -> owner_new (reassigns ONLY the listed entry IDs)
# - tag:       Finds all entries with TAG and reassigns them to TAG_NEW_OWNER (no CSV needed)
MODE=

# -----------------------------------------------------------------------------
# Input CSV (owner_map and entry_map)
# -----------------------------------------------------------------------------
# Name of your CSV inside the input/ folder next to this script, e.g. my-list.csv.
# Leave blank to be asked each run.
INPUT_FILENAME=

# --- owner_map headers ---
# Both columns are required: the script finds entries BY the old username.
COLUMN_HEADER_OLD=old_username
COLUMN_HEADER_NEW=new_username

# --- entry_map headers ---
# Required columns
COLUMN_HEADER_ENTRY_ID=entry_id
COLUMN_HEADER_OWNER=owner_new
# Optional column: who you expect owns each entry now. Recommended for
# tracking. When present, the output shows it next to the actual owner and
# flags any entry whose real owner is different.
COLUMN_HEADER_OWNER_OLD=owner_old
# When true, entries whose actual owner doesn't match owner_old are left
# alone (logged as skipped). When false, they're reassigned anyway and flagged.
SKIP_OWNER_MISMATCH=false

# -----------------------------------------------------------------------------
# Co-editors, co-publishers and co-viewers (all optional, every mode)
# -----------------------------------------------------------------------------
# Kaltura user or group IDs to add to EVERY reassigned entry, comma-separated.
# They're added to whatever co-users the entry already has, never replacing them.
#   Co-editor:    can edit the entry (details, captions, replace media...)
#   Co-publisher: can publish the entry to categories/channels
#   Co-viewer:    can watch the entry even where it's otherwise restricted
COEDITORS=
COPUBLISHERS=
COVIEWERS=

# Let the PREVIOUS owner keep access after the transfer. Blank = no access kept.
# Any of: editor, publisher, viewer (comma-separated, e.g. editor,publisher).
KEEP_OLD_OWNER_AS=

# Optional CSV columns for per-row co-users (owner_map and entry_map).
# Put several IDs in one cell separated by semicolons, e.g. jdoe;asmith
COLUMN_HEADER_CO_EDITORS=new_co_editors
COLUMN_HEADER_CO_PUBLISHERS=new_co_publishers
COLUMN_HEADER_CO_VIEWERS=new_co_viewers

# -----------------------------------------------------------------------------
# Tag mode settings (no CSV needed). Leave blank to be asked each run.
# -----------------------------------------------------------------------------
TAG=
TAG_NEW_OWNER=
# Comma-separated Kaltura entry statuses to include in the tag search.
# Defaults to all non-deleted statuses: PENDING(-1), IMPORT(0), PRECONVERT(1),
# READY(2), MODERATE(-2), BLOCKED(-3), NO_CONTENT(7).
# Set to "" to use Kaltura's own default (may exclude some statuses).
TAG_STATUS_IN=-1,0,1,2,-2,-3,7

# -----------------------------------------------------------------------------
# Execution Controls
# -----------------------------------------------------------------------------
# When true, no updates are performed. Script will only report what WOULD change.
DRY_RUN=true

# Number of concurrent workers (recommended: 10)
MAX_WORKERS=10

# Page size for baseEntry.list pagination (1–500)
PAGE_SIZE=100

# Retries for a failed ownership update, with exponential backoff
MAX_RETRIES=3
BACKOFF_BASE_SEC=0.5

# Optional delay between API requests per worker (seconds)
REQUEST_DELAY_SEC=0

# Check that each old (owner_map) / new user ID exists before starting
VALIDATE_OLD_USERS=true
VALIDATE_NEW_USERS=false
VALIDATE_PROGRESS_EVERY=10

# -----------------------------------------------------------------------------
# Reliability
# -----------------------------------------------------------------------------
# Seconds before an individual API request times out
REQUEST_TIMEOUT=120
# Retries for transient network errors (timeouts, resets) before giving up
MAX_NETWORK_RETRIES=5
# Base seconds between network retries (grows linearly: delay × attempt)
NETWORK_RETRY_DELAY=5

# -----------------------------------------------------------------------------
# Timezone for output filename timestamps
# -----------------------------------------------------------------------------
TIMEZONE=America/Los_Angeles
