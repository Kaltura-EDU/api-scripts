# SESSION VARIABLES -----------------------------------------------------------

# The partner IDs to copy FROM (source) and TO (destination). Find each in KMC
# under Settings > Integration Settings. Leave either blank and the script
# asks for it when it runs.
KALTURA_SOURCE_PARTNER_ID=
KALTURA_DEST_PARTNER_ID=

# The Kaltura service URL
KALTURA_SERVICE_URL=https://www.kaltura.com/

# Optional Kaltura user ID for audit logs (e.g., api-username). New entries
# are owned by this user unless DESTINATION_OWNER is set. Defaults to "admin".
KALTURA_USER=

# NOTE: the admin secrets are NOT stored here. The script prompts for both
# (source and destination) at runtime so they are never written to disk.

# RELIABILITY -----------------------------------------------------------------
# Transient network errors (timeouts, connection resets) are retried
# automatically. These are optional; the defaults shown are used if unset.

# Seconds before an individual API request times out
REQUEST_TIMEOUT=120
# Number of retries on transient network errors
MAX_NETWORK_RETRIES=5
# Base seconds between retries (grows linearly: delay × attempt)
NETWORK_RETRY_DELAY=5

# WHAT TO COPY ----------------------------------------------------------------

# true = copy auto-generated (ASR) captions and their transcript attachments.
# false = skip them (human captions and audio descriptions are still copied).
COPY_ASR_CAPTIONS=true

# How the script recognizes ASR captions when COPY_ASR_CAPTIONS=false: any
# caption whose label contains this text (case-insensitive). This is the
# suffix KMC adds to machine captions, set in KMC under Settings > Reach >
# Service Parameters. Enter ONLY the suffix, e.g. "(auto-generated)", so it
# matches every language.
AUTO_GENERATED_LABEL=(auto-generated)

# true = copy attachments (documents, files) to the new entries.
COPY_ATTACHMENTS=true

# DESTINATION SETTINGS --------------------------------------------------------

# Owner of the new entries. Blank = owned by KALTURA_USER. The user ID does
# not have to exist in the destination partner.
DESTINATION_OWNER=

# Co-editors and co-publishers for the new entries, comma-delimited
# (e.g. user1,user2). Blank = none.
DESTINATION_COEDITORS=
DESTINATION_COPUBLISHERS=

# Tag(s) added to every new entry, on top of the tags it already has.
# Comma-delimited. Handy for finding everything this script created.
DESTINATION_TAG=duplicated_entry

# WHICH ENTRIES TO COPY (OPTIONAL) --------------------------------------------
# Set ONE of these to skip the menu. Leave them all blank and the script asks
# you instead. If several are set, the first in this order wins:
#   INPUT_FILENAME, ENTRY_IDS, CATEGORY_ID, TAG

# A CSV of entry IDs in the "input" folder next to this script (e.g.
# entries.csv). Best for long lists.
INPUT_FILENAME=
# A comma-delimited list of entry IDs (e.g. 1_abc123,1_def456)
ENTRY_IDS=
# A category ID. Entries in its subcategories are included too.
CATEGORY_ID=
# A tag. Every entry with this tag is copied.
TAG=

# The header of the column holding entry IDs (not case-sensitive). A CSV with
# only one column works whatever its header says.
COLUMN_HEADER_ENTRY_ID=Entry ID
