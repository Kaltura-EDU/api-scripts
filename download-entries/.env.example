# download-entries.py configuration
# ---------------------------------------------------------------------------
# Copy this file to ".env" in the same folder and edit the values below.
# (On macOS, press Cmd+Shift+.  in Finder to show hidden dotfiles like .env.)
#
# IMPORTANT: your Admin Secret is NEVER stored here. The script always prompts
# for it at runtime.
# ---------------------------------------------------------------------------

# Your Kaltura Partner ID — the numeric account ID. It is not secret (it shows
# up in the KMC and in every API URL), so it is fine to keep here. If you leave
# it blank, the script will ask for it each time you run.
PARTNER_ID=

# Folder to download into (created automatically if it doesn't exist). This can
# be a simple name relative to the script, or a full path such as
# /Volumes/MyDrive/kaltura to download onto an external drive.
DOWNLOAD_FOLDER=output

# Number of downloads to run at once. Higher can be faster, but setting it too
# high can trip Kaltura rate limits. Minimum 1.
MAX_WORKERS=5

# How many times to retry a failing entry before giving up on it.
RETRY_ATTEMPTS=3

# Remove Kaltura's "(Source)" suffix and any trailing dashes/underscores from
# downloaded filenames. Set to false to keep the name exactly as Kaltura sends.
REMOVE_SUFFIX=true

# --- Filename options for entries that share the same title ---------------
# Entries with identical titles are ALWAYS saved as separate files: when two
# names would collide, the script automatically adds the entry ID so nothing is
# overwritten. The two options below let you control the naming up front instead
# of relying on that fallback. Both add their tag to the BEGINNING of the
# filename. Accepted values: true / false.

# Prepend the entry's created date and time (YYYY-MM-DD-HHMM, 24-hour) to every
# filename, e.g. "2025-03-14-0930_My Lecture.mp4".
APPEND_CREATED_DATE=false

# Prepend the entry ID to every filename, e.g. "1_5li7h9af_My Lecture.mp4".
# This guarantees a unique filename for every entry. If the created date is also
# enabled, the entry ID comes right after it: "2025-03-14-0930_1_5li7h9af_My Lecture.mp4".
APPEND_ENTRY_ID=false
