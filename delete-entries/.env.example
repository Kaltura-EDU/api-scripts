# SESSION VARIABLES -----------------------------------------------------------

# Your Kaltura Partner ID (found in KMC under Settings > Integration Settings)
PARTNER_ID=

# Admin secret is entered at runtime via a secure prompt — do not store it here

# User ID for the Kaltura session (optional; recommended for audit logs)
USER_ID=

# Kaltura API service URL
SERVICE_URL=https://www.kaltura.com

# Session privileges passed to the Kaltura API
PRIVILEGES=all:*,disableentitlement

# SCRIPT VARIABLES ------------------------------------------------------------

# Comma-separated list of entry IDs to delete or recycle
# Use either ENTRY_IDS or CSV_FILENAME — not both
ENTRY_IDS=

# OR: filename of a CSV containing entry IDs (relative to script directory)
CSV_FILENAME=
# The column header in the CSV that contains the entry IDs
ENTRY_ID_COLUMN_HEADER=

# Set to true to preview what would be deleted without making any API calls
DRY_RUN=true

# Set to false to skip the entry lookup phase and go straight to deletion.
# Faster, but the result CSV will not include entry name, owner, duration,
# or plays.
LOOKUP_BEFORE_ACTION=true

# Number of concurrent API calls.
# Default is 1; 10 is a reasonable value for large batches. Note that
# DELETE_RATE_PER_SEC below, not this, is what caps the delete rate.
MAX_WORKERS=10

# Kaltura throttles deletes and rejects anything above the limit with
# ACTION_BLOCKED. Measured on one account: at ~21 calls/sec only ~14% of
# deletes landed, holding steady at ~3.1-3.6 successful deletes/sec.
# Pacing below that ceiling gets nearly all of them through instead.
# Set to 0 to disable pacing.
DELETE_RATE_PER_SEC=2.5

# ACTION_BLOCKED is a throttle response, not a permanent state, so the
# script retries it: how many extra attempts, and the base seconds between
# them (the wait grows: 10, 20, 30, 40).
BLOCKED_RETRIES=4
BLOCKED_RETRY_DELAY=10

# Timeout settings (in seconds)
REQUEST_TIMEOUT_SEC=30
REQUEST_CONNECT_TIMEOUT_SEC=10

# Transient network errors (timeouts, dropped connections) are retried
# automatically. Total attempts per call, and the base wait between them —
# the wait grows linearly, so 5 seconds becomes 5, 10, 15, 20.
MAX_NETWORK_RETRIES=5
NETWORK_RETRY_DELAY=5
